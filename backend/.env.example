# Копируйте в .env и заполните. Не коммитьте .env.

# Сервер
PORT=3011
HOST=127.0.0.1

# JWT (обязательно для /api/login)
JWT_SECRET=замените_на_длинную_случайную_строку

# База: postgres (server.js читает backend/.env всегда из папки backend, не из cwd)
DB_DIALECT=postgres
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Опционально: SSL к облачной БД
# DB_SSL=true

# Первый админ (создаётся только если пользователя ещё нет)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=задайте_надёжный_пароль

# Гость: логин/пароль и чьи этапы видны (только просмотр, без POST/PUT/DELETE блоков)
# GUEST_USERNAME=Гость
# GUEST_PASSWORD=1
# GUEST_VIEW_OWNER=ProjectArchitect

# Владелец этапов и делегат (project_user): в БД у этапов ownerUsername должен совпадать с одним из этих логинов (без учёта регистра). Делегат видит этапы и по GUEST_VIEW_OWNER, и по PROJECT_ARCHITECT_USERNAME.
PROJECT_ARCHITECT_USERNAME=ProjectArchitect
PROJECT_USER_USERNAME=ProjectUser
PROJECT_USER_PASSWORD=user01

# CORS: через запятую, дополнительно к стандартным localhost-портам
# CORS_ORIGINS=http://localhost:3010
# Для внешнего staging без reverse proxy:
# CORS_ORIGINS=http://put-roadmap-staging.duckdns.org:3000

# При старте не выполняется массовое заполнение ownerUsername у этапов — данные блоков в БД не меняются.

# Вкладка «Пользователи» (справочник): GET /api/users/test-directory. По умолчанию при NODE_ENV != production. Только логин PROJECT_ARCHITECT_USERNAME.
# ENABLE_TEST_USER_DIRECTORY=true

# --- ИИ-ассистент (чат; секреты только на сервере, не коммитьте .env) ---
# ASSISTANT_ENABLED=false
# LLM_PROVIDER=gigachat
# Для OpenAI / совместимых API: LLM_API_KEY, LLM_BASE_URL, LLM_MODEL
# --- GigaChat: ключ Authorization Basic (base64) из кабинета Сбера ---
# GIGACHAT_AUTHORIZATION_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_VERIFY_SSL=true
# LLM_MAX_COMPLETION_TOKENS=2048
# LLM_TIMEOUT_MS=120000
