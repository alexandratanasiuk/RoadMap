# Скопируйте в .env / .env.local. См. https://vitejs.dev/guide/env-and-mode.html

# Куда проксировать /api в dev/preview (порт как PORT в backend/.env, по умолчанию 3011).
# DEV_PROXY_TARGET=http://127.0.0.1:3011

# Вкладка «Ассистент»: в dev UI включён по умолчанию, если не задано VITE_ASSISTANT_UI_ENABLED=false.
# VITE_ASSISTANT_UI_ENABLED=true

# Для выкладки как на main (заглушка до включения): не задавайте VITE_ASSISTANT_UI_ENABLED или задайте false;
# тогда на вкладке «Ассистент» на основной сборке показывается заглушка, пока не включите
# VITE_ASSISTANT_UI_ENABLED=true при сборке фронта и на backend — ASSISTANT_ENABLED=true,
# GIGACHAT_AUTHORIZATION_KEY (или другой LLM по LLM_PROVIDER). Полный список — backend/.env.example;
# на тесте обычно ещё: LLM_MODEL, LLM_MAX_COMPLETION_TOKENS, LLM_TIMEOUT_MS, GIGACHAT_SCOPE, GIGACHAT_VERIFY_SSL.
